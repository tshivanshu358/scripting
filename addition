#!/bin/bash

# Initial values
amount=480       # Starting amount
target=100000    # Target amount
rate=1.05        # 5% increase
day=1            # Start day

# Loop until the target is reached
echo "Day | Amount" > newfile.txt
while (( $(echo "$amount < $target" | bc -l) )); do
  printf "%3d | %.2f\n" "$day" "$amount" >> newfile.txt
  amount=$(echo "$amount * $rate" | bc -l)   # Increase amount by 5%
  ((day++))
done

echo "It will take $day days to reach ₹$target."

